# Build
/build/
/out/
compile_commands.json
CMakeUserPresets.json
.cache/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb

# Qt
*_autogen/
moc_*.cpp
qrc_*.cpp
ui_*.h
*.qm

# Packaging
/packaging/**/dist/
*.deb
*.rpm
*.dmg
*.msi
*.AppImage

# Journals and local sessions — never commit a user's drawing history
*.jsonl
!tests/journal/*.jsonl

# Large data. /data is versioned deliberately (see .claude/data.md); binaries are not.
/data/**/*.tif
/data/**/*.gpkg
/data/**/*.laz
/data/**/*.gsb
/data/corpus/index/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Agent worktrees. `git worktree add` puts a live checkout here; sweeping one in
# with `git add -A` commits it as a gitlink to a commit no clone can resolve.
.claude/worktrees/

# MPYY kaynak ekleri. Resmî Gazete'den indirilen .docx/.xlsx dosyaları depoya
# girmez; katalog scripts/mpyy-cikar.py ile bunlardan üretilir.
/.mpyy-kaynak/

# Python bytecode from the /scripts extractors and gates.
__pycache__/
*.pyc

# Desktop and tooling droppings
.directory
__pycache__/
*.pyc

# The design reference lives in /data/design, which is a directory Article 3.1
# names. `Screenshots/` is not — it is the drop folder the reference arrived in,
# and it stays local. `scripts/ci-gate-design.sh` fails if the two copies drift,
# so an edit made in either place is caught rather than silently lost.
/Screenshots/
