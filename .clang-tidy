# SPDX-License-Identifier: GPL-3.0-or-later
# KentOSCad static analysis. A finding is fixed, never suppressed (CLAUDE.md 5.14).
---
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -portability-avoid-pragma-once,
  -readability-braces-around-statements,
  -misc-include-cleaner,
  -clang-analyzer-optin.core.EnumCastOutOfRange

# Three checks are switched off because they contradict a decision recorded
# elsewhere, and a linter arguing with the house style teaches everyone to ignore
# the linter — which is how a real finding gets missed (CLAUDE.md 5.14).
#
#   portability-avoid-pragma-once     `#pragma once` is deliberate. MSVC 19.40,
#                                     GCC 13+, Clang 17+ and AppleClang all
#                                     support it; the compiler floor is Article 2.
#   readability-braces-around-statements
#                                     `.clang-format` sets
#                                     AllowShortIfStatementsOnASingleLine, so this
#                                     check would fight the formatter on every
#                                     early return.
#   misc-include-cleaner              IWYU owns include hygiene and runs as its own
#                                     step in `make check`. Two tools giving
#                                     different advice about the same line is worse
#                                     than one.
#   clang-analyzer-optin.core.EnumCastOutOfRange
#                                     KentOSCad uses `enum class` for two things this
#                                     check reads as a mistake, both of them
#                                     deliberate and both recorded in
#                                     `.claude/model.md`. EntityKey and LayerKey are
#                                     strong typedefs over an integer id (R1-R5): the
#                                     valid values are every id ever minted, and
#                                     naming them as enumerators is not possible.
#                                     CommandSpec::Flags is a bit mask: a combination
#                                     of two flags is by construction not a named
#                                     enumerator. Keeping the check on would mean
#                                     giving up type safety on identifiers to satisfy
#                                     a checker, which is the trade backwards.

WarningsAsErrors: 'bugprone-*,cert-*,clang-analyzer-*'
HeaderFilterRegex: '.*/kentos_cad/.*'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  # cert-err33-c is bugprone-unused-return-value with a fixed function list. An
  # explicit `(void)` cast is not a suppression: it is the author stating at the
  # call site that the result was considered and discarded, which is exactly what
  # the check exists to force. Without this option the only way to satisfy it is a
  # `// NOLINT`, and that is the suppression CLAUDE.md 5.14 forbids.
  - key: cert-err33-c.AllowCastToVoid
    value: true
  - key: bugprone-unused-return-value.AllowCastToVoid
    value: true
