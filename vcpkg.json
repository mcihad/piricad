{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "piricad",
  "version": "0.1.0",
  "description": "Türkiye odaklı CBS + CAD harita yazılımı",
  "homepage": "https://github.com/piricad/piricad",
  "license": "GPL-3.0-or-later",

  "$comment": [
    "Manifest mode with a pinned baseline (CLAUDE.md 5.12: no unpinned dependency).",
    "Phase 0 builds with nothing but Qt 6 (CLAUDE.md Article 8.2), so every entry",
    "below is a FEATURE, not a base dependency. A feature is enabled only together",
    "with its PIRICAD_WITH_<NAME> CMake option.",
    "Before enabling any of these: read its LICENSE, confirm GPLv3 compatibility,",
    "record it in NOTICE and regenerate the CycloneDX SBOM in the same PR."
  ],

  "builtin-baseline": "0000000000000000000000000000000000000000",
  "dependencies": [],

  "features": {
    "gdal": {
      "description": "Format I/O — PIRICAD_WITH_GDAL",
      "dependencies": [{ "name": "gdal", "version>=": "3.9.0" }]
    },
    "proj": {
      "description": "Coordinate transformation, TUREF/TM3 and geoid grids — PIRICAD_WITH_PROJ",
      "dependencies": [{ "name": "proj", "version>=": "9.4.0" }]
    },
    "geos": {
      "description": "Overlay, buffer, predicates — PIRICAD_WITH_GEOS",
      "dependencies": [{ "name": "geos", "version>=": "3.12.0" }]
    },
    "cgal": {
      "description": "Exact arithmetic, straight skeleton for setbacks — PIRICAD_WITH_CGAL",
      "dependencies": [{ "name": "cgal", "version>=": "5.6" }]
    },
    "lua": {
      "description": "Embedded hot-path script layer — PIRICAD_WITH_LUA",
      "dependencies": [
        { "name": "lua", "version>=": "5.4.6" },
        { "name": "sol2", "version>=": "3.3.0" }
      ]
    },
    "clipper": {
      "description": "Polygon boolean and offset",
      "dependencies": [{ "name": "clipper2", "version>=": "1.3.0" }]
    },
    "spatial-index": {
      "description": "R-tree spatial indexing",
      "dependencies": [{ "name": "boost-geometry", "version>=": "1.85.0" }]
    },
    "tests": {
      "description": "doctest, replacing tests/support/microtest.hpp",
      "dependencies": [{ "name": "doctest", "version>=": "2.4.11" }]
    }
  }
}
